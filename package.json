{
  "name": "pu-conferences",
  "version": "1.0.0",
  "private": true,
  "description": "PU Conferences WordPress theme with custom Gutenberg blocks.",
  "scripts": {
    "start": "wp-scripts start --webpack-src-dir=blocks-src --output-path=build",
    "build": "wp-scripts build --webpack-src-dir=blocks-src --output-path=build",
    "lint:js": "wp-scripts lint-js blocks-src",
    "format": "wp-scripts format blocks-src",
    "test": "wp-scripts test-unit-js --passWithNoTests"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/html-entities": "^4.0.0"
  }
}
